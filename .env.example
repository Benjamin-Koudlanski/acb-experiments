# ── LLM Backend Configuration ──────────────────────────────────────
# Uncomment and fill in the backend you want to use.

# Option 1: OpenAI API (GPT-4o, GPT-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Local Ollama (LLaMA-3-70B, etc.)
# LOCAL_MODEL_URL=http://localhost:11434
# LOCAL_MODEL_NAME=llama3:70b

# Option 3: vLLM server
# VLLM_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── General Settings ──────────────────────────────────────────────
# Max concurrent API requests (rate limiting)
MAX_CONCURRENT=5

# Results output directory
OUTPUT_DIR=results/

# Random seed for reproducibility
SEED=42
